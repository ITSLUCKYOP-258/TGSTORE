# ---- Telegram Bot API storage ----
# Create a bot with @BotFather and paste its token here (or use the Setup Wizard)
BOT_TOKEN=

# A private channel/supergroup where files are stored.
# The bot must be an ADMIN of this channel (with post messages permission).
# Get the id by forwarding a channel message to @userinfobot (e.g. -1001234567890)
STORAGE_CHANNEL_ID=

# Public https origin of your deployment (used for the Telegram Login Widget redirect)
# Local development: leave empty and use the Dev Login button instead.
PUBLIC_BASE_URL=

# Secret used to sign session JWTs -- change this!
JWT_SECRET=change-me-to-a-long-random-string

# Allow a one-click local dev login (no Telegram account needed)
DEV_LOGIN=true

# ---- MTProto user login (phone number + OTP, like TeleDrive) ----
# Get your own api_id & api_hash at https://my.telegram.org -> API development tools
# Leave empty to disable phone login (bot login / dev login still work).
MT_API_ID=
MT_API_HASH=

# Server port
PORT=8787
